# Copy these into the Community Cloud "Secrets" box (or into .streamlit/secrets.toml for a local run).

DATABASE_URL = "postgresql://postgres.xxxx:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"  # Supabase > Connect > Session pooler
SUPABASE_URL = "https://xxxx.supabase.co"
SUPABASE_KEY = "service_role key"          # Supabase > Settings > API Keys (keep secret)

OPENAI_API_KEY = "sk-..."                  # always required: book search uses OpenAI embeddings
ANTHROPIC_API_KEY = "sk-ant-..."           # optional: each key you add enables that writer
# optional: Gemini through Vertex AI. Paste the whole service-account JSON file between the triple quotes.
GOOGLE_SERVICE_ACCOUNT_JSON = """
{ "type": "service_account", "project_id": "...", "private_key": "...", "client_email": "..." }
"""
GOOGLE_CLOUD_LOCATION = "global"           # optional, default global
